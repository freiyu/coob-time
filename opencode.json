{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["docs/CODEMAP.md"],
  "mcp": {
    "testsprite": {
      "type": "local",
      "command": ["npx", "-y", "@testsprite/testsprite-mcp@latest"],
      "environment": {
        "API_KEY": "{env:TESTSPRITE_API_KEY}"
      },
      "enabled": true,
      "timeout": 30000
    }
  },
  "tools": {
    "testsprite*": true
  },
  "agent": {
    "build": {
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "context-keeper": "allow",
          "project-manager": "allow",
          "tester": "allow",
          "reviewer": "allow",
          "anti-slop": "allow",
          "testsprite-runner": "allow"
        },
        "bash": {
          "*": "allow",
          "git push*": "ask",
          "git push --force*": "deny",
          "git reset --hard*": "deny",
          "git clean*": "deny",
          "vercel*": "ask",
          "npx vercel*": "ask"
        }
      }
    }
  }
}
